---
// src/pages/index.astro: home (scrolling landing). Replaces the old overlay gate.
// Sections: hero → case studies → our garden (community) → now → footer.
import Garden from '../layouts/Garden.astro';
import HeartCanvas from '../components/HeartCanvas.astro';
import Icon from '../components/Icon.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import CaseStudyRail from '../components/CaseStudyRail.astro';
import { site } from '../config/design';
---

<Garden title={site.name} description={site.description}>
  <div class="home">

    <!-- ── Hero ─────────────────────────────────────────────────────────── -->
    <section class="hero">
      <h1 class="hero-title">
        Gi designs creative <em>systems</em>, <em>products</em>, &amp; <em>experiences</em>.
      </h1>
      <div class="hero-heart">
        <HeartCanvas />
      </div>
    </section>

    <!-- ── Featured case studies ─────────────────────────────────────────── -->
    <CaseStudyRail />

    <!-- ── About intro ──────────────────────────────────────────────────── -->
    <section class="about-intro">
      <div class="about-card-sizer">
      <div class="about-card">
        <div class="about-card-main">
          <div class="about-photo-wrap">
            <img class="about-photo" src="/images/portrait.png" alt="Gianna Crisha Saludo" />
          </div>
          <div class="about-card-body">
            <div class="about-domain">giannacrisha.com</div>
            <div class="about-name">Gianna Crisha Saludo</div>
            <div class="about-role">designer · developer · anthropologist</div>
          </div>
        </div>
        <div class="about-card-footer">
          <div class="about-socials">
            <a href="https://linkedin.com/in/giannacrisha" class="about-social" aria-label="LinkedIn" target="_blank" rel="noopener">
              <Icon name="linkedin" size={16} />
            </a>
            <a href="https://github.com/giannacrisha" class="about-social" aria-label="GitHub" target="_blank" rel="noopener">
              <Icon name="github" size={16} />
            </a>
            <a href="https://x.com/giannaesque" class="about-social" aria-label="X" target="_blank" rel="noopener">
              <Icon name="x" size={16} />
            </a>
            <a href="https://bsky.app/profile/giannacrisha.com" class="about-social" aria-label="Bluesky" target="_blank" rel="noopener">
              <Icon name="bluesky" size={16} />
            </a>
          </div>
          <a href="https://linktr.ee/giannacrisha" class="about-chip" aria-label="Linktree" target="_blank" rel="noopener">
            <img src="/linktree-qr.svg" class="about-chip-img" alt="" />
          </a>
        </div>
      </div>
      </div>
      <div class="about-blurb">
        <p class="about-text">
          hey, im gi! i was raised in metro manila, grew up in abu dhabi, then moved to butuan. now, im based in boston and currently a wien international scholar at brandeis university!
        </p>
        <a href="/about" class="about-link"><em>get to know me</em> →</a>
      </div>
    </section>

    <!-- ── Our garden (community) ───────────────────────────────────────── -->
    <section class="community-summary">
      <header class="sec-head sec-head--center">
        <div class="comm-title-row">
          <a class="sec-title" href="/community">community</a>
          <button class="sec-phon kapwa-trigger" id="kapwa-trigger">/ˈkap.wa/</button>
        </div>
      </header>
      <div class="comm-row-wrap">
        <div class="comm-row">
          {Array.from({ length: 9 }).map((_, i) => (
            <a href="/community" class="comm-tile" style={`--i:${i}`} aria-label="visit the community garden">
              <canvas class="comm-pixel-canvas" width="96" height="96" data-tile-idx={i}></canvas>
              <img class="comm-frame" src="/frames/square.png" alt="" aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>
      <div class="comm-btn-wrap">
        <a href="/community" class="btn">join us →</a>
      </div>
    </section>

    <!-- kapwa terminal modal -->
    <div class="kapwa-terminal" id="kapwa-terminal" role="dialog" aria-modal="true" aria-hidden="true">
      <TerminalWindow title="kapwa.sh" class="kt-window">
        <pre class="kt-body"></pre>
      </TerminalWindow>
    </div>


  </div>
</Garden>

<style>
  .home {
    --home-max: 1152px;
    max-width: var(--home-max);
    margin-inline: auto;
    padding-inline: clamp(20px, 5vw, 64px);
  }

  /* shared section heading (Lora, gold) */
  .sec-head {
    display: flex;
    align-items: baseline;
    gap: clamp(12px, 2vw, 32px);
    flex-wrap: wrap;
    margin-bottom: var(--space-xxl);
  }
  .sec-head--center { justify-content: center; flex-direction: column; align-items: center; text-align: center; gap: 4px; }
  .sec-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-section);
    color: var(--color-heading);
    line-height: 1.1;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .sec-title:hover { opacity: 0.72; }
  .sec-phon {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-lg);
    color: var(--color-heading);
    opacity: 0.85;
  }
  .kapwa-trigger {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s, opacity 0.15s;
  }
  .kapwa-trigger:hover {
    opacity: 1;
    text-decoration-color: var(--color-heading);
  }
  .kapwa-terminal {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .kapwa-terminal.is-open { opacity: 1; pointer-events: auto; }
  .kt-window { width: min(520px, 90vw); }
  .kt-body {
    padding: 24px 28px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--text-base);
    line-height: 2.2;
    color: #d4d4d4;
    margin: 0;
    white-space: pre-wrap;
    text-align: left;
  }
  .kt-blink { display: inline-block; animation: kt-blink 1s step-start infinite; }
  @keyframes kt-blink { 50% { opacity: 0; } }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .hero {
    display: flex;
    align-items: center;
    gap: clamp(24px, 4vw, 48px);
    padding-block: clamp(56px, 12vw, 168px);
  }
  .hero-title {
    flex: 1 1 0;
    min-width: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(34px, 5.2vw, 64px);
    line-height: 1.12;
    color: var(--color-heading);
    max-width: 16ch;
  }
  .hero-title em { font-style: italic; }
  .hero-heart {
    flex: 0 0 auto;
    display: flex;
    justify-content: center;
  }

  /* ── About intro ─────────────────────────────────────────────────────── */
  .about-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(40px, 7vw, 96px);
  }

  /* left: blurb */
  .about-blurb { display: flex; flex-direction: column; gap: var(--space-xl); }
  .about-text {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: var(--leading-loose);
    color: var(--color-fg);
    max-width: 38ch;
  }
  .about-link {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    color: var(--color-heading);
    text-decoration: none;
    width: fit-content;
    border-bottom: 1px solid var(--color-accent-border);
    padding-bottom: 2px;
    transition: color 0.15s, border-color 0.15s;
  }
  .about-link:hover { color: var(--color-fg); border-color: var(--color-fg); }
  .about-link em { font-style: italic; }

  /* left: access card */
  .about-card-sizer {
    position: relative;
    width: 100%;
    aspect-ratio: 1.588 / 1;
    container-type: inline-size;
  }
  .about-card {
    /* glow color: change just this hex (the hover gloss) */
    --glow-color: #ffe3ba;

    position: absolute;
    inset: 0;
    background: var(--card-grad);
    border-radius: 5cqw;
    padding: 6cqw;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    box-shadow:
      0 12px 40px rgba(144, 100, 47, 0.38),
      0 2px 8px rgba(0, 0, 0, 0.18),
      0 0 0 1px rgba(255, 215, 80, 0.2) inset;
    transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1), box-shadow 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform;
    cursor: default;
  }
  /* cursor-tracking gloss */
  .about-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 5cqw;
    background: radial-gradient(
      circle at var(--mx, 50%) var(--my, 50%),
      rgb(from var(--glow-color) r g b / 0.22) 0%,
      rgb(from var(--glow-color) r g b / 0.06) 38%,
      rgb(from var(--glow-color) r g b / 0) 65%
    );
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s;
  }
  .about-card:hover::after { opacity: 1; }
  .about-card-main {
    display: flex;
    align-items: center;
    gap: 5cqw;
  }
  .about-photo-wrap {
    flex-shrink: 0;
    width: 26cqw;
    height: 26cqw;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid rgba(255,255,255,0.35);
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }
  .about-photo { width: 100%; height: 100%; object-fit: cover; display: block; }
  .about-card-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5cqw;
  }
  .about-domain {
    font-family: var(--font-mono);
    font-size: 3.5cqw;
    color: rgba(255,255,255,0.55);
    letter-spacing: 0.04em;
  }
  .about-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 5.5cqw;
    color: #fff;
    line-height: 1.15;
  }
  .about-role {
    font-family: var(--font-body);
    font-size: 3.5cqw;
    color: rgba(255,255,255,0.72);
    line-height: 1.3;
  }
  .about-card-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: auto;
  }
  .about-socials {
    display: flex;
    gap: 3cqw;
  }
  .about-social {
    color: rgba(255,255,255,0.65);
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }
  .about-social svg { width: 4.5cqw; height: 4.5cqw; }
  .about-social:hover { color: #fff; }
  /* QR / linktree chip */
  .about-chip {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .about-chip-img {
    width: 12cqw;
    height: 12cqw;
    opacity: 0.7;
    transition: opacity 0.15s;
    border-radius: 2px;
  }
  .about-chip:hover .about-chip-img { opacity: 1; }

  /* ── Community ────────────────────────────────────────────────────────── */
  .community-summary { padding-block: clamp(40px, 7vw, 96px); }
  .comm-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }
  .comm-btn-wrap {
    display: flex;
    justify-content: center;
    margin-top: var(--space-xl);
  }
  .comm-row-wrap {
    position: relative;
  }
  .comm-row-wrap::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 120px;
    height: 100%;
    background: linear-gradient(to left, var(--color-bg) 0%, transparent 100%);
    pointer-events: none;
    z-index: 2;
  }
  .comm-row { display: flex; gap: clamp(12px, 2vw, 24px); overflow-x: auto; padding: var(--space-md) 2px; scrollbar-width: none; }
  .comm-row::-webkit-scrollbar { display: none; }
  /* tiles 5–9 blur progressively, an affordance that more exists.
     --tile-o = each tile's resting opacity (reused as the reveal end-state) */
  .comm-tile:nth-child(5) { filter: blur(0.5px); opacity: 0.95; --tile-o: 0.95; }
  .comm-tile:nth-child(6) { filter: blur(1.5px); opacity: 0.85; --tile-o: 0.85; }
  .comm-tile:nth-child(7) { filter: blur(2.5px); opacity: 0.70; --tile-o: 0.70; }
  .comm-tile:nth-child(8) { filter: blur(4px);   opacity: 0.52; --tile-o: 0.52; }
  .comm-tile:nth-child(9) { filter: blur(6px);   opacity: 0.35; --tile-o: 0.35; }
  .comm-tile {
    --tile-o: 1;
    flex: 0 0 auto;
    width: clamp(100px, 14vw, 160px);
    aspect-ratio: 1 / 1;
    position: relative;
    text-decoration: none;
    transition: transform 0.18s ease;
  }
  .comm-tile:hover { transform: translateY(-4px); }
  /* staggered fade + rise: frames appear one by one when scrolled into view */
  .comm-row.reveal-armed .comm-tile { opacity: 0; }
  .comm-row.reveal-run .comm-tile {
    animation: comm-rise 0.6s cubic-bezier(0.23, 1, 0.32, 1) both;
    animation-delay: calc(var(--i) * 75ms);
  }
  @keyframes comm-rise {
    from { opacity: 0; transform: translateY(26px); }
    to   { opacity: var(--tile-o); transform: translateY(0); }
  }
  .comm-pixel-canvas {
    position: absolute;
    inset: 23%;
    width: 54%;
    height: 54%;
    image-rendering: pixelated;
    display: block;
  }
  .comm-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    pointer-events: none;
    z-index: 1;
  }

  /* ── Typing cursor ───────────────────────────────────────────────────── */
  .title-cursor {
    display: inline-block;
    font-style: normal;
    color: var(--color-heading);
    animation: blink-cursor 0.75s step-start infinite;
    margin-left: 2px;
  }
  @keyframes blink-cursor { 50% { opacity: 0; } }

  /* ── About section entrance animation ────────────────────────────────── */
  .about-card-sizer.will-animate,
  .about-blurb.will-animate {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.65s ease, transform 0.65s ease;
  }
  .about-card-sizer.is-visible,
  .about-blurb.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .about-blurb.will-animate { transition-delay: 0.28s; }

  /* ── Responsive ───────────────────────────────────────────────────────── */
  @media (max-width: 820px) {
    .hero { flex-direction: column; text-align: center; }
    .hero-title { max-width: none; }
  }
  @media (max-width: 768px) {
    .hero-heart { display: none; }
    .about-intro { grid-template-columns: 1fr; }
    .about-text { max-width: none; }
    .about-card-sizer { max-width: 360px; margin-inline: auto; }
  }
</style>

<script is:inline>
(function () {
  var GRID = 16;
  var canvases = document.querySelectorAll('.comm-pixel-canvas');
  if (!canvases.length) return;

  fetch('https://api.github.com/repos/giannacrisha/giannacrisha.github.io/issues?labels=community-garden&state=open&per_page=100', {
    headers: { Accept: 'application/vnd.github+json', 'X-GitHub-Api-Version': '2022-11-28' }
  })
  .then(function (res) { return res.ok ? res.json() : []; })
  .then(function (issues) {
    var submissions = issues.map(function (i) {
      try { var p = JSON.parse(i.body); return p && p.pixels ? p : null; }
      catch (e) { return null; }
    }).filter(Boolean);

    // Sort by hearts desc (same as community page)
    submissions.sort(function (a, b) { return (b.hearts || 0) - (a.hearts || 0); });

    // Only paint first 9 canvases
    canvases.forEach(function (canvas, idx) {
      var s = submissions[idx];
      if (!s) return;
      var ctx = canvas.getContext('2d');
      var cell = canvas.width / GRID;
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      s.pixels.forEach(function (color, i) {
        if (!color) return;
        ctx.fillStyle = color;
        ctx.fillRect((i % GRID) * cell, Math.floor(i / GRID) * cell, cell, cell);
      });
    });
  })
  .catch(function () {});
})();
</script>

<script>
// ── Typing animation for hero title ──────────────────────────────────────
(function () {
  var h1 = document.querySelector('.hero-title');
  if (!h1 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var segs = [
    { t: 'Gi designs creative ', em: false },
    { t: 'systems', em: true },
    { t: ', ', em: false },
    { t: 'products', em: true },
    { t: ', & ', em: false },
    { t: 'experiences', em: true },
    { t: '.', em: false },
  ];

  var chars: Array<{ch: string, em: boolean}> = [];
  segs.forEach(function (seg) {
    seg.t.split('').forEach(function (ch) { chars.push({ ch: ch, em: seg.em }); });
  });

  h1.textContent = '';
  var cursor = document.createElement('span');
  cursor.className = 'title-cursor';
  cursor.textContent = '|';
  h1.appendChild(cursor);

  var i = 0;
  var currentEm: HTMLElement | null = null;
  var inEm = false;

  function typeNext() {
    if (i >= chars.length) {
      setTimeout(function () { cursor.remove(); }, 900);
      return;
    }
    var item = chars[i++];
    if (item.em !== inEm) {
      inEm = item.em;
      if (inEm) {
        currentEm = document.createElement('em');
        h1!.insertBefore(currentEm, cursor);
      } else {
        currentEm = null;
      }
    }
    if (inEm && currentEm) {
      currentEm.textContent += item.ch;
    } else {
      h1!.insertBefore(document.createTextNode(item.ch), cursor);
    }
    setTimeout(typeNext, 38 + Math.random() * 28);
  }

  setTimeout(typeNext, 350);
})();

// ── About section entrance animation ─────────────────────────────────────
(function () {
  var sizer = document.querySelector('.about-card-sizer');
  var blurb = document.querySelector('.about-blurb');
  var section = document.querySelector('.about-intro');
  if (!sizer || !blurb || !section) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  sizer.classList.add('will-animate');
  blurb.classList.add('will-animate');

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        (sizer as Element).classList.add('is-visible');
        (blurb as Element).classList.add('is-visible');
        io.disconnect();
      }
    });
  }, { threshold: 0.12 });
  io.observe(section);
})();

// ── Community frames reveal one by one on scroll into view (once) ─────────
(function () {
  var row = document.querySelector('.comm-row');
  if (!row) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var tiles = row.querySelectorAll('.comm-tile');
  if (!tiles.length) return;
  var last = tiles[tiles.length - 1];

  row.classList.add('reveal-armed');   // hide until in view

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (!entry.isIntersecting) return;
      io.disconnect();
      (row as Element).classList.add('reveal-run');  // play staggered animation
    });
  }, { threshold: 0.25 });
  io.observe(row);

  // once the last (most-delayed) tile finishes, hand control back to base CSS
  last.addEventListener('animationend', function () {
    (row as Element).classList.remove('reveal-armed', 'reveal-run');
  });
})();

// ── Kapwa terminal ────────────────────────────────────────────────────────
(function () {
  var trigger  = document.getElementById('kapwa-trigger');
  var terminal = document.getElementById('kapwa-terminal');
  if (!trigger || !terminal) return;

  var PROMPT_HTML =
    '<span style="color:#89b4fa">giannacrisha@Giannas-MacBook-Air</span> ' +
    '<span style="color:#89b4fa">giannacrisha.github.io</span> ' +
    '<span style="color:#cdd6f4">%</span> ';
  var CMD = 'cat kapwa.sh';
  var FILE_CONTENT =
    '\nKapwa is a Filipino social psychology\n' +
    'concept that translates to "shared\n' +
    'identity" or "togetherness."\n' +
    '\nWell-being, joy, and struggles are\n' +
    'inherently tied to those around you.\n' +
    '\nIt means recognizing the\n' +
    '"self in the other."\n';

  var typeTimer: number | null = null;

  function playTerminal() {
    var body = terminal!.querySelector('.kt-body');
    if (!body) return;
    if (typeTimer !== null) { clearTimeout(typeTimer); typeTimer = null; }

    body.innerHTML =
      '<span>' + PROMPT_HTML + '<span class="kt-cmd"></span><span class="kt-blink">▋</span></span>';

    var cmdEl  = body.querySelector<HTMLElement>('.kt-cmd')!;
    var cursor = body.querySelector<HTMLElement>('.kt-blink')!;
    var i = 0;

    function typeNext() {
      if (i < CMD.length) {
        cmdEl.textContent += CMD[i++];
        typeTimer = setTimeout(typeNext, 65 + Math.random() * 45) as unknown as number;
      } else {
        typeTimer = setTimeout(function () {
          cursor.remove();
          var out = document.createElement('span');
          out.textContent = '\n' + FILE_CONTENT + '\n';
          body!.appendChild(out);
          var p2 = document.createElement('span');
          p2.innerHTML = PROMPT_HTML + '<span class="kt-blink">▋</span>';
          body!.appendChild(p2);
        }, 250) as unknown as number;
      }
    }
    typeTimer = setTimeout(typeNext, 450) as unknown as number;
  }

  function open() {
    terminal!.classList.add('is-open');
    terminal!.removeAttribute('aria-hidden');
    playTerminal();
  }
  function close() {
    terminal!.classList.remove('is-open');
    terminal!.setAttribute('aria-hidden', 'true');
    if (typeTimer !== null) { clearTimeout(typeTimer); typeTimer = null; }
  }

  trigger.addEventListener('click', open);
  terminal!.addEventListener('click', function (e) { if (e.target === terminal) close(); });
  terminal!.querySelector('[data-tw-close]')?.addEventListener('click', close);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && terminal!.classList.contains('is-open')) close();
  });
})();
</script>

<script>
(function () {
  var card = document.querySelector<HTMLElement>('.about-card');
  if (!card) return;
  var MAX = 16;

  card.addEventListener('mousemove', function (e) {
    var me = e as MouseEvent;
    var r = card!.getBoundingClientRect();
    var x = (me.clientX - r.left) / r.width;
    var y = (me.clientY - r.top)  / r.height;
    var rotY =  (x - 0.5) * MAX * 2;
    var rotX = -(y - 0.5) * MAX * 2;
    card!.style.transition = 'transform 0.08s ease-out, box-shadow 0.08s ease-out';
    card!.style.transform = 'perspective(700px) rotateX(' + rotX + 'deg) rotateY(' + rotY + 'deg) scale3d(1.025,1.025,1.025)';
    card!.style.setProperty('--mx', (x * 100) + '%');
    card!.style.setProperty('--my', (y * 100) + '%');
  });

  card.addEventListener('mouseleave', function () {
    card!.style.transition = 'transform 0.6s cubic-bezier(0.23, 1, 0.32, 1), box-shadow 0.6s cubic-bezier(0.23, 1, 0.32, 1)';
    card!.style.transform = 'perspective(700px) rotateX(0deg) rotateY(0deg) scale3d(1,1,1)';
    card!.style.setProperty('--mx', '50%');
    card!.style.setProperty('--my', '50%');
  });
})();
</script>

