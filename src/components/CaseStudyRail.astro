---
// src/components/CaseStudyRail.astro
// Featured case studies. The section pins while the page scrolls past it and the
// cards travel horizontally: card N exits left as card N+1 arrives.
//
// Movement is a CSS scroll-driven animation (`animation-timeline`) where supported;
// where it isn't, an IntersectionObserver sets data-state on each card and the same
// transforms run as transitions. JS never touches scroll position except on an
// explicit indicator click or focus jump: the page always scrolls natively.
//
// Card data: src/data/case-studies.ts
import { caseStudies } from '../data/case-studies';

const n = caseStudies.length;
---

<section class="rail" aria-label="selected work">
  <div class="rail-track" data-rail style={`--n: ${n}`}>

    {/* One per card, stacked down the track. The observer uses these to decide
        which card is active while the stage is pinned. */}
    <div class="rail-sentinels" aria-hidden="true">
      {caseStudies.map((_, i) => <div class="rail-sentinel" data-sentinel={i}></div>)}
    </div>

    <div class="rail-stage" data-stage data-active="0">
      <ol class="rail-cards" data-cards>
        {caseStudies.map((study, i) => {
          // coming soon = no href: a plain block, so it can't be clicked or tabbed to
          const Body = study.href ? 'a' : 'div';
          return (
            <li class="rail-card" style={`--i: ${i}`} data-card={i} data-state={i === 0 ? 'current' : 'next'} data-far={i > 1 ? '' : undefined} data-soon={study.href ? undefined : ''}>
              <Body class="rail-card-body" href={study.href}>
                <div class="rail-card-media">
                  {study.image && <img class="rail-card-img" src={study.image} alt="" loading="lazy" />}
                </div>
                <div class="rail-card-block">
                  <h3 class="rail-card-title">{study.title}</h3>
                  {!study.href && <span class="rail-card-soon">coming soon</span>}
                </div>
              </Body>
            </li>
          );
        })}
      </ol>

      <nav class="rail-dots" aria-label="case study navigation">
        {caseStudies.map((study, i) => (
          <button class="rail-dot" type="button" data-goto={i} aria-label={`go to ${study.title}`} aria-current={i === 0 ? 'true' : 'false'}>
            <span class="rail-dot-mark"></span>
          </button>
        ))}
      </nav>
    </div>
  </div>
</section>

<style>
  /* ── Track + pinned stage ───────────────────────────────────────────────
     The track is n viewports tall; the stage sticks to the top for its whole
     length, so scroll distance through the track is the animation's progress. */
  .rail-track {
    position: relative;
    /* one viewport of pinned stage, plus --pace-card of scrolling for each
       move between cards. This height IS the animation's duration. */
    height: calc(100svh + (var(--n) - 1) * var(--pace-card));
    /* full-bleed: the side slots sit near the viewport edges, outside the
       .home column this component is mounted in. body is overflow-x: clip. */
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    /* the cards' transforms change as the active card changes; without this,
       scroll anchoring treats that as content shift and cancels the smooth
       scroll an indicator click just started */
    overflow-anchor: none;
  }

  .rail-sentinels {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: repeat(var(--n), 1fr);
  }

  .rail-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-xl);
    /* clip, not hidden: hidden makes this a scroll container, and the browser
       then scrolls it sideways to reveal a focused card, shifting the layout */
    overflow: clip;
    /* clear the fixed nav at the top and the minimize bar at the bottom */
    padding-block: calc(var(--nav-height) + var(--space-lg)) var(--space-section);
  }

  /* ── Cards ──────────────────────────────────────────────────────────────
     Every card sits in the same grid cell, centred; transform alone decides
     whether it reads as the centre card or a side slot. */
  .rail-cards {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    place-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rail-card {
    grid-area: 1 / 1;
    /* 562/1280 of the frame, shrinking on short viewports so the card and its
       copy still fit the stage */
    width: min(44vw, calc(52svh * 562 / 312));
    /* centre-to-centre distance to a side slot, as a share of card width:
       half this card + the mock's 50px gap + half a 0.46-scaled card */
    --rail-offset: 82%;
    will-change: transform, opacity, filter;
  }
  /* a card more than one slot away would stack on top of the one in the slot */
  .rail-card[data-far] { visibility: hidden; }

  /* No card chrome: the image is the card. Only it is rounded, and the copy
     sits directly on the page below it. */
  /* An <a> for a live study, a <div> for one coming soon. Only the link gets
     hover feedback, so a coming-soon card reads as inert. */
  .rail-card-body {
    display: block;
    position: relative;
    text-decoration: none;
    color: inherit;
  }

  .rail-card-media {
    aspect-ratio: 562 / 312;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-accent-light);
    box-shadow: var(--shadow-gold);
  }
  /* no image yet: a quiet empty slot instead of a gold-washed frame */
  .rail-card-media:not(:has(img)) {
    background: var(--color-card);
    border: var(--border);
    box-shadow: none;
  }
  /* coming soon: the frame steps back. On the media, not the card, so it
     doesn't fight the card's own opacity and blur poses. */
  .rail-card[data-soon] .rail-card-media {
    opacity: var(--opacity-soon);
    filter: saturate(var(--saturate-soon));
  }
  .rail-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-card) var(--ease-out-quiet);
  }
  .rail-card-body[href]:hover .rail-card-img { transform: scale(1.02); }

  /* The title hangs below the media rather than sitting inside the card box,
     so the card's box IS the image, which is what the side slots scale and
     centre against. Title left, coming-soon label right, on one baseline. */
  .rail-card-block {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: var(--space-lg);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }
  .rail-card-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-heading);
    line-height: var(--leading-tight);
    transition: opacity var(--dur-text) var(--ease-out-quiet);
  }
  .rail-card-body[href]:hover .rail-card-title { opacity: 0.72; }
  /* a quiet uppercase label rather than a bordered chip */
  .rail-card-soon {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ── The card arrives, then it speaks ───────────────────────────────────
     Time-based (not scroll-based) so the delay after settling is real time. */
  .rail-card-block {
    opacity: 0;
    transform: translateY(var(--space-sm));
    transition:
      opacity   var(--dur-text) var(--ease-out-quiet),
      transform var(--dur-text) var(--ease-out-quiet);
  }
  .rail-card[data-state='current'] .rail-card-block {
    opacity: 1;
    transform: none;
    transition-delay: var(--delay-text);
  }

  /* ── Movement: scroll-driven where supported ────────────────────────────
     One keyframe set for every card. A card's range is shifted by its index so
     that its midpoint (the in-place pose) lands on its own slot of the track.
     `both` fill holds the end poses outside the range. */
  @keyframes rail-slot {
    0% {
      transform: translateX(var(--rail-offset)) scale(var(--scale-recede));
      opacity: var(--opacity-recede);
      filter: blur(var(--blur-recede));
    }
    50% {
      transform: translateX(0) scale(1);
      opacity: 1;
      filter: blur(0);
    }
    100% {
      transform: translateX(calc(-1 * var(--rail-offset))) scale(var(--scale-recede));
      opacity: var(--opacity-recede);
      filter: blur(var(--blur-recede));
    }
  }

  @supports (animation-timeline: view()) {
    .rail-track { view-timeline-name: --rail; view-timeline-axis: block; }

    .rail-card {
      animation-name: rail-slot;
      animation-fill-mode: both;
      animation-timing-function: var(--ease-out-quiet);
      animation-timeline: --rail;
      /* `contain` spans exactly the pinned stretch. Each card owns two slots:
         one entering, one leaving, so the first and last reach past the ends. */
      animation-range:
        contain calc((var(--i) - 1) / (var(--n) - 1) * 100%)
        contain calc((var(--i) + 1) / (var(--n) - 1) * 100%);
    }
  }

  /* ── The three poses ────────────────────────────────────────────────────
     Also the base state: a view timeline is inactive until its subject starts
     entering, so without these the cards would sit stacked before the rail is
     reached. Where the timeline is supported it overrides these; where it isn't,
     the observer moves cards between them via the transition below. */
  .rail-card[data-state='next'] {
    transform: translateX(var(--rail-offset)) scale(var(--scale-recede));
    opacity: var(--opacity-recede);
    filter: blur(var(--blur-recede));
  }
  .rail-card[data-state='current'] {
    transform: translateX(0) scale(1);
    opacity: 1;
    filter: blur(0);
  }
  .rail-card[data-state='prev'] {
    transform: translateX(calc(-1 * var(--rail-offset))) scale(var(--scale-recede));
    opacity: var(--opacity-recede);
    filter: blur(var(--blur-recede));
  }

  /* Only the fallback animates between the poses: with a scroll timeline the
     animation supplies every frame and a transition would fight it. */
  @supports not (animation-timeline: view()) {
    .rail-card {
      transition:
        transform var(--dur-card) var(--ease-out-quiet),
        opacity   var(--dur-card) var(--ease-out-quiet),
        filter    var(--dur-card) var(--ease-out-quiet);
    }
  }

  /* ── Progress indicator ─────────────────────────────────────────────────── */
  .rail-dots {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
  }
  .rail-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: var(--space-xs);
    cursor: pointer;
  }
  /* a short bar that lengthens when active: no borders, no arrows */
  .rail-dot-mark {
    display: block;
    width: var(--space-xl);
    height: var(--rule-thickness);
    border-radius: var(--radius-pill);
    background: var(--color-border);
    transition:
      background-color var(--dur-text) var(--ease-out-quiet),
      width            var(--dur-text) var(--ease-out-quiet);
  }
  .rail-dot:hover .rail-dot-mark { background: var(--color-accent); }
  .rail-dot[aria-current='true'] .rail-dot-mark {
    width: var(--space-section);
    background: var(--color-heading);
  }

  /* ── Mobile: no pinning, swipe carousel ─────────────────────────────────── */
  @media (max-width: 768px) {
    .rail-track { height: auto; }
    .rail-sentinels { display: none; }
    .rail-stage {
      position: static;
      height: auto;
      overflow: visible;
      padding-block: var(--space-section);
    }
    .rail-cards {
      display: flex;
      gap: var(--space-lg);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      /* start-aligned so the last card is actually reachable: centre alignment
         leaves it short of a snap point at the end of the scroller */
      scroll-padding-inline: var(--space-lg);
      padding-inline: var(--space-lg);
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .rail-cards::-webkit-scrollbar { display: none; }
    /* [data-state] so this beats the pose rules: the carousel does the moving now */
    .rail-card[data-state] {
      position: static;
      flex: 0 0 86%;
      scroll-snap-align: start;
      animation: none;
      transform: none;
      opacity: 1;
      filter: none;
      visibility: visible;
      width: auto;
    }
    .rail-card-body { display: flex; flex-direction: column; gap: var(--space-lg); }
    /* static, and always readable in the carousel: nothing is waiting to arrive */
    .rail-card .rail-card-block {
      position: static;
      margin-top: 0;
      opacity: 1;
      transform: none;
      transition-delay: 0s;
    }
  }

  /* ── Reduced motion: no pinning, no transitions, plain vertical stack ───── */
  @media (prefers-reduced-motion: reduce) {
    .rail-track { height: auto; }
    .rail-sentinels { display: none; }
    .rail-stage {
      position: static;
      height: auto;
      overflow: visible;
      padding-block: var(--space-section);
    }
    .rail-cards {
      display: flex;
      flex-direction: column;
      gap: var(--space-xl);
      overflow: visible;
    }
    .rail-card[data-state] {
      position: static;
      animation: none;
      transform: none;
      opacity: 1;
      filter: none;
      visibility: visible;
      width: auto;
      transition: none;
    }
    .rail-card-body { display: flex; flex-direction: column; gap: var(--space-lg); }
    .rail-card .rail-card-block {
      position: static;
      margin-top: 0;
      opacity: 1;
      transform: none;
      transition: none;
    }
    .rail-dots { display: none; }
  }
</style>

<script>
  // Tracks which card is active and handles indicator clicks. Movement itself is
  // CSS; this only reflects position and performs explicit, user-asked scrolls.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const mobile  = matchMedia('(max-width: 768px)');

  document.querySelectorAll<HTMLElement>('[data-rail]').forEach(track => {
    const stage = track.querySelector<HTMLElement>('[data-stage]');
    const list  = track.querySelector<HTMLElement>('[data-cards]');
    const cards = [...track.querySelectorAll<HTMLElement>('[data-card]')];
    const dots  = [...track.querySelectorAll<HTMLElement>('[data-goto]')];
    if (!stage || !list || !cards.length) return;

    let active = 0;

    const setActive = (i: number) => {
      active = Math.max(0, Math.min(cards.length - 1, i));
      stage.dataset.active = String(active);
      cards.forEach((card, c) => {
        card.dataset.state = c < active ? 'prev' : c > active ? 'next' : 'current';
        if (Math.abs(c - active) > 1) card.dataset.far = '';
        else delete card.dataset.far;
      });
      dots.forEach((dot, d) => dot.setAttribute('aria-current', String(d === active)));
    };

    // Scroll to a card. Horizontal in carousel mode, vertical through the pinned
    // track otherwise: either way it's one smooth scroll, not a snap handler.
    const goTo = (i: number) => {
      const target = Math.max(0, Math.min(cards.length - 1, i));
      if (mobile.matches || reduced.matches) {
        // scroll the carousel itself: scrollIntoView would also jump the page
        const pad = parseFloat(getComputedStyle(list).scrollPaddingInlineStart) || 0;
        const left = list.scrollLeft
          + cards[target].getBoundingClientRect().left
          - list.getBoundingClientRect().left
          - pad;
        list.scrollTo({ left, behavior: 'smooth' });
      } else {
        // the pinned stretch is the track minus one viewport, and card i sits in
        // place at i/(n-1) along it: same split the animation ranges use
        const span = track.offsetHeight - window.innerHeight;
        const step = cards.length > 1 ? span / (cards.length - 1) : 0;
        window.scrollTo({ top: track.offsetTop + target * step, behavior: 'smooth' });
      }
      // deliberately not setActive() here: that rewrites the cards' transforms
      // mid-flight, which interrupts the smooth scroll we just started. The
      // observer sets the state as the scroll arrives.
    };

    dots.forEach(dot => dot.addEventListener('click', () => goTo(Number(dot.dataset.goto))));

    if (reduced.matches) return;  // plain stack: native focus scrolling is fine

    // Tabbing into a card brings it into view: transforms put it off-screen, so
    // the browser's own focus scrolling can't do this for us. Only linked cards
    // take focus; a coming-soon card is reached through its indicator.
    cards.forEach((card, i) => {
      card.addEventListener('focusin', () => { if (i !== active) goTo(i); });
    });

    // In carousel mode watch the cards inside their scroller; while pinned, watch
    // the sentinels striped down the track and take whichever crosses the middle.
    const watch = () => {
      const carousel  = mobile.matches;
      const targets   = carousel ? cards : [...track.querySelectorAll<HTMLElement>('[data-sentinel]')];
      const indexOf   = (el: Element) =>
        Number(carousel ? (el as HTMLElement).dataset.card : (el as HTMLElement).dataset.sentinel);

      const io = new IntersectionObserver(
        entries => {
          const hit = entries.find(e => e.isIntersecting);
          if (hit) setActive(indexOf(hit.target));
        },
        carousel
          ? { root: list, threshold: 0.6 }
          // a band across the middle, not a zero-height line: a collapsed root
          // never reports a non-empty intersection
          : { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
      );
      targets.forEach(t => io.observe(t));
      return io;
    };

    let observer = watch();
    mobile.addEventListener('change', () => { observer.disconnect(); observer = watch(); });
    setActive(0);
  });
</script>
