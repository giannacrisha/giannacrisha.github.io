---
// src/components/TableOfContents.astro
// Renders a table of contents from rendered-markdown headings (h2 + h3).
// variant="inline" sits in the article body as a <details> (mobile);
// variant="sidebar" is a fixed button below the nav that opens a panel of
// links (desktop). CSS shows whichever fits the viewport.
// Self-hides when there are fewer than two headings. The active-heading
// highlight, smooth scroll and panel toggle are emitted once no matter how
// many instances appear on the page.
import Icon from './Icon.astro';

interface Heading { depth: number; slug: string; text: string }
interface Props {
  headings: Heading[];
  variant?: 'inline' | 'sidebar';
  label?: string;
}
const { headings, variant = 'inline', label = 'in this article' } = Astro.props;
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
const isSidebar = variant === 'sidebar';
// same list either way; only the disclosure wrapper differs
const Wrap = isSidebar ? 'div' : 'details';
const Head = isSidebar ? 'button' : 'summary';
const wrapAttrs = isSidebar ? {} : { open: true };
const headAttrs = isSidebar
  ? { type: 'button', 'aria-expanded': 'false', 'aria-controls': 'toc-panel' }
  : {};
---
{tocHeadings.length >= 2 && (
  <nav class:list={['toc', `toc-${variant}`]} aria-label="Table of contents">
    <Wrap class="toc-details" {...wrapAttrs}>
      <Head class="toc-label" {...headAttrs}>
        {label}
        <Icon name="chevron-down" size={11} class="toc-chevron" />
      </Head>
      <div class="toc-content" id={isSidebar ? 'toc-panel' : undefined}>
        <ol class="toc-list">
          {tocHeadings.map(h => (
            <li class:list={['toc-item', { 'toc-item--h3': h.depth === 3 }]}>
              <a href={`#${h.slug}`} class="toc-link" data-heading={isSidebar ? h.slug : undefined}>{h.text}</a>
            </li>
          ))}
        </ol>
      </div>
    </Wrap>
  </nav>
)}

<style>
  .toc-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-muted);
    letter-spacing: 0.1em;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color 0.15s;
  }
  .toc-label::-webkit-details-marker { display: none; }
  .toc-label:hover { color: var(--color-fg); }
  .toc-label :global(.toc-chevron) {
    flex-shrink: 0;
    transition: transform var(--dur-text) var(--ease-out-quiet);
  }
  .toc-details[open] :global(.toc-chevron),
  .toc-label[aria-expanded="true"] :global(.toc-chevron) { transform: rotate(180deg); }

  .toc-list {
    list-style: none;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .toc-item { padding: 0; }
  .toc-item--h3 { padding-left: var(--space-lg); }
  .toc-link {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-decoration: none;
    line-height: 1.8;
    display: block;
    transition: color 0.15s;
    border-left: 2px solid transparent;
    padding-left: var(--space-sm);
  }
  .toc-link:hover { color: var(--color-fg); }
  .toc-link.active {
    color: var(--color-fg);
    border-left-color: var(--color-accent);
  }

  /* ── Inline: <details> in the article flow ────────────────────────────── */
  .toc-inline {
    margin: var(--space-xxl) 0;
    padding: var(--space-lg) var(--space-xl);
    background: var(--color-accent-light);
    border-radius: var(--radius-card);
    border: var(--border);
  }
  /* Smooth collapse: a grid wrapper animates between 0fr and 1fr.
     The author display:grid overrides the UA `display:none` that <details>
     applies to closed content, so the list stays in flow and can transition. */
  .toc-inline .toc-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.25s ease;
  }
  .toc-inline .toc-details[open] .toc-content { grid-template-rows: 1fr; }
  .toc-inline .toc-list {
    padding-top: var(--space-md);
    min-height: 0;
    overflow: hidden;
  }

  /* ── Sidebar: fixed button below the nav, panel opens under it ────────── */
  .toc-sidebar {
    position: fixed;
    top: calc(var(--nav-height) + var(--space-md));
    right: var(--space-xl);
    z-index: 40; /* over the article, under the nav drawer and search modal */
  }
  .toc-sidebar .toc-label {
    padding: var(--space-xs) var(--space-md);
    background: var(--color-card);
    border: var(--border);
    border-radius: var(--radius-pill);
  }
  .toc-sidebar .toc-label[aria-expanded="true"] { color: var(--color-fg); }
  .toc-sidebar .toc-content {
    position: absolute;
    top: calc(100% + var(--space-sm));
    right: 0;
    width: var(--width-toc);
    /* leaves room below for the fixed theme toggle and the tab dock */
    max-height: calc(100svh - var(--nav-height) - 3 * var(--space-section));
    overflow-y: auto;
    padding: var(--space-md) var(--space-lg);
    background: var(--color-card);
    border: var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-gold);
    opacity: 0;
    visibility: hidden;
    transform: translateY(calc(-1 * var(--space-xs)));
    transition: opacity var(--dur-text) var(--ease-out-quiet),
                transform var(--dur-text) var(--ease-out-quiet),
                visibility 0s linear var(--dur-text);
  }
  .toc-sidebar .toc-label[aria-expanded="true"] + .toc-content {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  @media (min-width: 900px) { .toc-inline { display: none; } }
  @media (max-width: 899px) { .toc-sidebar { display: none; } }
</style>

<script>
  // Active-heading highlight tracks the sidebar links (the ones with data-heading).
  const tocLinks = document.querySelectorAll('.toc-link[data-heading]') as NodeListOf<HTMLAnchorElement>;
  if (tocLinks.length > 0) {
    const headingEls = Array.from(tocLinks)
      .map(link => document.getElementById(link.dataset.heading!))
      .filter(Boolean) as HTMLElement[];

    function updateActive() {
      let active = headingEls[0];
      for (const el of headingEls) {
        if (el.getBoundingClientRect().top <= 120) active = el;
      }
      tocLinks.forEach(link => {
        link.classList.toggle('active', link.dataset.heading === active?.id);
      });
    }
    window.addEventListener('scroll', updateActive, { passive: true });
    updateActive();
  }

  // Sidebar panel: the button toggles it; a link, an outside click or Escape closes it.
  const toggle = document.querySelector<HTMLButtonElement>('.toc-sidebar .toc-label');
  const panel = document.getElementById('toc-panel');
  if (toggle && panel) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean) => toggle.setAttribute('aria-expanded', String(open));
    document.addEventListener('click', (e) => {
      const target = e.target as Element;
      if (toggle.contains(target)) setOpen(!isOpen());
      else if (!panel.contains(target) || target.closest('.toc-link')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !isOpen()) return;
      setOpen(false);
      toggle.focus();
    });
  }

  // Smooth scroll applies to every TOC link (inline + sidebar).
  document.querySelectorAll('.toc-link').forEach(link => {
    link.addEventListener('click', (e) => {
      const href = (link as HTMLAnchorElement).getAttribute('href');
      if (!href?.startsWith('#')) return;
      e.preventDefault();
      const target = document.querySelector(href);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.pushState(null, '', href);
      }
    });
  });
</script>
